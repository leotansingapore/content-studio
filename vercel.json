{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "content-studio-beige-eta.vercel.app"
        }
      ],
      "destination": "https://consultant-content-studio.vercel.app/generate",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mb-studio/api/board",
      "destination": "https://moneybees-studio.vercel.app/api/board"
    },
    {
      "source": "/mb-studio/api/cards/:id",
      "destination": "https://moneybees-studio.vercel.app/api/cards/:id"
    },
    {
      "source": "/mb-studio/api/cards/:id/comments",
      "destination": "https://moneybees-studio.vercel.app/api/cards/:id/comments"
    },
    {
      "source": "/mb-studio/api/cards/:id/comments/:cid",
      "destination": "https://moneybees-studio.vercel.app/api/cards/:id/comments/:cid"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/mb-studio/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
