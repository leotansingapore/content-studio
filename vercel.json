{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "content-studio-beige-eta.vercel.app"
        }
      ],
      "destination": "https://app.postmosis.com/generate",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/t/:slug",
      "destination": "https://hgdbflprrficdoyxmdxe.supabase.co/functions/v1/tracked-link/:slug"
    },
    {
      "source": "/:path((?!api/|og/|assets/|news/|ads/|covers/|t/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|MicrosoftPreview|Google-PageRenderer|redditbot|Embedly|Iframely|Pinterestbot).*"
        }
      ],
      "destination": "/api/page-og?path=:path"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "headers": []
}
