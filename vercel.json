{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "content-studio-beige-eta.vercel.app"
        }
      ],
      "destination": "https://consultant-content-studio.vercel.app/generate",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mb-studio/api/:path*",
      "destination": "https://moneybees-studio.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
